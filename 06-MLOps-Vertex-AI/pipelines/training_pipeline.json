                }
              }
            },
            "taskInfo": {
              "name": "modele-accepte"
            },
            "triggerPolicy": {
              "condition": "inputs.parameter_values['pipelinechannel--train-auc_pr'] >= inputs.parameter_values['pipelinechannel--min_auc_pr']"
