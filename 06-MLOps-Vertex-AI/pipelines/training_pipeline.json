    "comp-condition-branches-1": {
      "dag": {
        "tasks": {
          "condition-2": {
            "componentRef": {
              "name": "comp-condition-2"
            },
            "inputs": {
              "artifacts": {
                "pipelinechannel--train-model": {
                  "componentInputArtifact": "pipelinechannel--train-model"
                }
              },
              "parameters": {
                "pipelinechannel--min_auc_pr": {
                  "componentInputParameter": "pipelinechannel--min_auc_pr"
